// Prisma schema. See https://pris.ly/d/prisma-schema for syntax reference.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum Role {
  USER
  INSTRUCTOR
  ADMIN
}

enum ClassSlotStatus {
  SCHEDULED
  CANCELLED_BEFORE
  CANCELLED_DURING
  COMPLETED
}

/// Reasons the INSTRUCTOR cancels in advance because they personally can't
/// make the class. Used together with `cancellationKind = PERSONAL`.
enum PersonalCancellationReason {
  SAUDE
  PESSOAL
  CLIMA
  OUTRO
}

/// Reasons the studio cancels the class itself (typically the live cancel
/// during a session, but also bulk pre-cancels). Used together with
/// `cancellationKind = STUDIO`.
enum StudioCancellationReason {
  CHUVA
  VENTO
  RAIO
  TECNICO
  MAR_ALTO
  MANUTENCAO
  SEGURANCA
  BAIXA_ADESAO
  OUTRO
}

enum CancellationKind {
  PERSONAL
  STUDIO
}

enum ReservationStatus {
  ACTIVE
  CHECKED_IN
  COMPLETED
  NO_SHOW
  CANCELLED_BY_USER
  CANCELLED_BY_STUDIO
}

/// G1 — lifecycle of a friend invite. PENDING is the only "live" state;
/// the other three are terminal records preserved for audit (so a user
/// can't re-spam after a decline without re-sending).
enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum CreditSource {
  PURCHASE_PACK
  SUBSCRIPTION_CYCLE
  ADMIN_GRANT
  REFUND
  /// 2026-05 — credits sent from another user via the "transfer to friend"
  /// flow. The new pack inherits the original pack's expiry.
  TRANSFER
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAUSED
  CANCELLED
  PAST_DUE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  /// 2026-05 — the Pix charge passed its due date without being paid (the
  /// QR code expired). Distinct from FAILED so the UI can offer "gerar
  /// novo QR" instead of a generic error. Set by the reconciliation cron
  /// and by the on-demand sync when Asaas reports OVERDUE.
  EXPIRED
  /// 2026-05 — card charge accepted by Asaas but held for manual fraud
  /// review (`AWAITING_RISK_ANALYSIS`). NOT paid yet — no CreditPack is
  /// minted. The webhook (`PAYMENT_CONFIRMED`) or the reconciliation cron
  /// resolves it to PAID or FAILED. UI shows "em análise".
  IN_REVIEW
}

/// 2026-05 — origin of a CreditDebt row.
enum CreditDebtReason {
  REFUND
  CHARGEBACK
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
}

enum PaymentKind {
  ONE_OFF_PACK
  SUBSCRIPTION_CYCLE
}

enum BikeStatus {
  OPERATIONAL
  MAINTENANCE
  OUT_OF_SERVICE
}

/// Restricted to the bikebeach palette (item 16.1). Drives the colored
/// chip / pill that represents a class kind in the calendar, on the home,
/// and inside the dashboard. Repetition across kinds is allowed by design.
enum ClassKindColor {
  CLAY
  SUN
  SEA
  SAND
  INK
  GREEN
}

/// Profile field: what the user is training for. Drives default class
/// suggestions and analytics. Optional at signup.
enum UserGoal {
  PERDER_PESO
  GANHAR_CONDICIONAMENTO
  MANTER_FORMA
  COMPETIR
  OUTRO
}

/// Self-reported fitness level. Optional at signup.
enum FitnessLevel {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
}

// =============================================================================
// Tenancy
// =============================================================================

/// A physical location where classes happen (a stretch of beach).
model Unit {
  id                          String   @id @default(cuid())
  name                        String
  slug                        String   @unique
  address                     String
  /// Free-text descrição da arena (admin-managed) — usada na home e no
  /// drawer de detalhes. Adicionada na Fase B1 (2026-05).
  description                 String?
  isActive                    Boolean  @default(true)
  /// Layout bounds for the bike grid editor (B3, 2026-05). Free range —
  /// admin picks rows (A-J max, 2..10) and cols (1..12) when designing the
  /// arena. The PHYSICAL bike count is independent: it tracks the active
  /// `Bike` rows for this unit. Capacity of a class slot derives from the
  /// bike count, not from the grid bounds.
  maxRows                     Int      @default(4)
  maxCols                     Int      @default(8)
  /// Late-check-in tolerance (minutes after class start). Hidden from the
  /// admin form per 2026-05 — kept here so behavior remains configurable
  /// per arena via direct DB access if needed; defaults to 5 system-wide.
  lateCheckinToleranceMinutes Int      @default(5)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  staff      User[]
  bikes      Bike[]
  classSlots ClassSlot[]
  /// Inverse of `InstructorArena.unit` — instructors who can teach here.
  /// Driven by the M2M table; `staff` (single-side) stays for ADMIN role.
  instructorAssignments InstructorArena[] @relation("ArenaInstructors")
}

// =============================================================================
// Identity
// =============================================================================

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  passwordHash       String
  name               String
  phone              String?
  /// Brazilian CPF — required by Asaas to create a customer. Captured at
  /// signup or via PATCH; can be null for staff who never purchase.
  cpf                String?
  /// Lazily set the first time the user makes a purchase. 1:1 with our User.
  asaasCustomerId    String?       @unique
  role               Role          @default(USER)
  /// Set for INSTRUCTOR (mandatory) and optionally for ADMIN scoped to a unit.
  /// Regular USERs are global — they may book at any active unit.
  unitId             String?
  unit               Unit?         @relation(fields: [unitId], references: [id])
  isActive           Boolean       @default(true)
  /// Profile fields collected at signup (optional).
  birthDate          DateTime?
  goal               UserGoal?
  fitnessLevel       FitnessLevel?
  /// True when the user must change their password before doing anything else
  /// (e.g. staff created by admin with a temporary password). Cleared on
  /// first successful password change.
  mustChangePassword Boolean       @default(false)
  /// Free-text bio shown on instructor profile (admin-managed). Required
  /// for INSTRUCTOR role — enforced at service layer.
  bio                String?
  /// Relative path to the instructor's portrait, served as static asset
  /// from the API (`/uploads/instructors/<userId>.png`). PNG with
  /// transparent background — produced client-side via
  /// `@imgly/background-removal` before upload. Null = render placeholder.
  photoUrl           String?
  /// Carro-chefe — the instructor's signature ClassKind. Drives the avatar
  /// tint on cards and the home-page hero. Always one of their
  /// `instructorSpecialties`. Added in C1 (2026-05).
  primaryClassKindId String?
  primaryClassKind   ClassKind?    @relation("PrimaryClassKind", fields: [primaryClassKindId], references: [id])

  /// G1 — short shareable token used to add this user as a friend. Lazily
  /// generated the first time the user opens the friends tab; null for
  /// existing rows that never asked for one. 8 chars, base32-ish alphabet
  /// (no I/O/0/1) — see `friend-code.ts`.
  friendCode                   String? @unique
  /// G1 — global "modo invisível" toggle. When true, this user is hidden
  /// from the `friends-attending` payload of every slot. Doesn't break
  /// existing friendships; just mutes presence.
  hideReservationsFromFriends  Boolean @default(false)

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  liabilityAcceptances  LiabilityAcceptance[]
  parqResponses         ParqResponse[]
  instructedClassSlots  ClassSlot[]           @relation("InstructedSlots")
  cancelledClassSlots   ClassSlot[]           @relation("CancelledByUserSlots")
  reservations          Reservation[]
  cancelledReservations Reservation[]         @relation("ReservationCancelledBy")
  waitlistEntries       WaitlistEntry[]
  creditPacks           CreditPack[]
  /// 2026-05 — packs the user co-owns (was added as a friend by the
  /// buyer). The buyer's own packs are listed via `creditPacks` above.
  creditPackCoOwnerships CreditPackCoOwner[]
  subscriptions         Subscription[]
  payments              Payment[]
  /// 2026-05 — credit debts owed after a refund/chargeback. While any has
  /// `remainingCredits > 0` the user can't make new reservations.
  creditDebts           CreditDebt[]
  loggedBikeMaintenance BikeMaintenance[]     @relation("BikeMaintenanceLogger")
  instructorSpecialties InstructorSpecialty[]
  /// 2026-05 — instructor multi-arena. An INSTRUCTOR can teach at one or
  /// more arenas. `User.unitId` is preserved as the legacy single-side
  /// pointer so ADMIN scoping keeps working; for INSTRUCTOR the canonical
  /// source is this M2M. See `InstructorArena`.
  arenaAssignments      InstructorArena[]     @relation("InstructorArenas")
  /// Outgoing + incoming friend-related rows. Two relation names because
  /// the same User shows up on either side of a request and a friendship.
  friendRequestsSent     FriendRequest[] @relation("FriendRequestFrom")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestTo")
  friendshipsAsA         Friendship[]    @relation("FriendshipA")
  friendshipsAsB         Friendship[]    @relation("FriendshipB")

  @@index([unitId])
}

/// Junction table for INSTRUCTOR ↔ arenas (2026-05). Lets the same
/// instructor appear on the staff list of multiple arenas without
/// duplicating User rows. Rows are managed via `UsersService.createStaff`
/// and `updateStaff` when an admin picks N arenas for the instructor.
model InstructorArena {
  userId    String
  user      User     @relation("InstructorArenas", fields: [userId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit     @relation("ArenaInstructors", fields: [unitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, unitId])
  @@index([unitId])
}

/// Many-to-many: which class kinds an INSTRUCTOR is qualified to teach.
/// Drives the instructor profile and the class-kind dropdown on the
/// calendar (filtered to the picked instructor's specialties).
model InstructorSpecialty {
  userId      String
  classKindId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classKind   ClassKind @relation(fields: [classKindId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([userId, classKindId])
  @@index([classKindId])
}

/// One row per issued refresh token. Hashed (sha256) — never stored in plain.
/// Rotation: on /refresh we revoke the used token and link the new one via
/// `replacedByTokenId`. If a revoked token is presented again it counts as
/// reuse and we revoke every active token of that user.
model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @unique
  createdByIp       String?
  userAgent         String?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// One row per password-reset request. Token sent to e-mail, stored as sha256.
/// Single-use: once consumed (`usedAt` set) it can't be presented again.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// =============================================================================
// Health gate (LGPD-sensitive)
// =============================================================================

/// Each row = one acceptance event. Latest row drives validity (monthly window).
model LiabilityAcceptance {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Document version the user accepted (e.g. "v1.0"). Bumping the version
  /// effectively forces a new acceptance from everyone on next reservation.
  version    String
  ipAddress  String?
  userAgent  String?
  acceptedAt DateTime @default(now())

  @@index([userId, acceptedAt(sort: Desc)])
}

/// Each row = one PAR-Q submission. Latest row drives validity (quarterly window).
model ParqResponse {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    String
  /// Free-form JSON of question→answer pairs, validated by the controller.
  answers    Json
  ipAddress  String?
  userAgent  String?
  acceptedAt DateTime @default(now())

  @@index([userId, acceptedAt(sort: Desc)])
}

// =============================================================================
// Domain — bikes, classes, reservations, waitlist
// =============================================================================

/// A physical bike at a Unit. Reusable across many class slots — a Reservation
/// is what couples a (slot, bike) for a specific user at a specific time.
model Bike {
  id        String     @id @default(cuid())
  unitId    String
  unit      Unit       @relation(fields: [unitId], references: [id])
  /// Studio-facing label, e.g. "Bike 01" or "A1". Unique within a unit.
  label     String
  /// Grid coordinates within the arena. `row` = single uppercase letter
  /// (A, B, ...), `col` = 1-based column. Pair must be unique per unit so
  /// no two bikes share the same physical spot. Nullable to support
  /// fresh-cadastrada bikes that haven't been placed in the layout yet
  /// (admin drops them in via the layout editor — B3, 2026-05).
  row       String?
  col       Int?
  /// Operational state. Only OPERATIONAL bikes are bookable. RESERVED is NOT
  /// stored — it's derived at runtime from active reservations on the slot.
  status    BikeStatus @default(OPERATIONAL)
  /// Free-text for instructor reference (maintenance notes, special equipment).
  notes     String?
  /// 2026-05 — soft-delete via timestamp. When set, the bike disappears
  /// from every list endpoint + the arena layout but stays in the DB so
  /// historical reservations still resolve to a label. Hard-delete is
  /// only allowed when the bike has zero reservations (handled at
  /// service-layer); otherwise use this flag.
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  reservations    Reservation[]
  maintenanceLogs BikeMaintenance[]

  @@unique([unitId, label])
  @@unique([unitId, row, col], name: "Bike_unitId_row_col_key")
  @@index([unitId, status])
}

/// Service-history entry per bike. Schema-only for now — no service/controller
/// in v1 (admin UI defers to v2). Lets us start logging revisions when the
/// portal is ready without another migration.
model BikeMaintenance {
  id          String   @id @default(cuid())
  bikeId      String
  bike        Bike     @relation(fields: [bikeId], references: [id], onDelete: Cascade)
  loggedById  String
  loggedBy    User     @relation("BikeMaintenanceLogger", fields: [loggedById], references: [id])
  description String
  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([bikeId, performedAt(sort: Desc)])
}

/// Pre-defined kinds of class (sunrise / sunset / power / beat-drill / almoço /
/// noturno). Seeded with a starter set; admin can add/disable. ClassSlot.kindId
/// is optional — legacy/free-text slots are still allowed.
model ClassKind {
  id                     String   @id @default(cuid())
  /// Stable machine slug (e.g. "sunrise"). Unique.
  slug                   String   @unique
  /// Display name in pt-BR.
  name                   String
  /// Default duration when the instructor picks this kind. They can override.
  defaultDurationMinutes Int
  /// 1 (chill) → 5 (extreme). UI hint only.
  intensity              Int      @default(3)
  /// Free-text vibe descriptor for the UI (e.g. "Despertar enérgico").
  /// Editorial copy — never used to derive color.
  tone                   String?
  /// Design system color picked by the admin (B2). Drives chip/pill rendering
  /// across the app. Defaults to SEA so unmigrated rows keep working.
  colorToken             ClassKindColor @default(SEA)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  classSlots            ClassSlot[]
  instructorSpecialties InstructorSpecialty[]
  /// Reverse side of `User.primaryClassKind` (carro-chefe).
  primaryForInstructors User[]                @relation("PrimaryClassKind")
}

/// Pricing offer for one-off credit packs. Replaces the old
/// PACK_PRICING_CENTS constant — admin can tune from the dashboard.
///
/// 2026-05 — packs are GLOBAL across every arena. The legacy `unitId`
/// column was dropped: there is one source of truth per `classes` count.
/// 2026-05 — `isTransferable` and `maxSharedUsers` open the gate for
/// resulting CreditPacks to be transfered (credit-by-credit) or shared
/// (co-owned by friends). Both default off.
model PackOffer {
  id             String   @id @default(cuid())
  /// Number of credits in this pack (1 = avulso, 10 / 20 = packs). Unique
  /// globally — admin "edits" by patching the row.
  classes        Int      @unique
  priceCents     Int
  /// Days after purchase that the resulting CreditPack expires.
  expirationDays Int
  isActive       Boolean  @default(true)
  /// Smaller first in UI.
  displayOrder   Int      @default(0)
  /// Optional time-windowed discount (C3 / item 17). All three fields move
  /// together — service rejects partial sets. `discountPercent` is 1-100;
  /// the discount is "active" when `now ∈ [discountStartsAt, discountEndsAt]`.
  /// The /planos public renders a strikethrough + "−X% até DD/MM" badge.
  discountPercent   Int?
  discountStartsAt  DateTime?
  discountEndsAt    DateTime?
  /// 2026-05 — when true, buyers can transfer N credits from the resulting
  /// CreditPack to a friend (creates a new CreditPack on their side with
  /// the same expiry).
  isTransferable    Boolean  @default(false)
  /// 2026-05 — when > 0, buyers can pick up to N friends to co-own the
  /// resulting CreditPack. Co-owners share a single credit pool. 0 means
  /// "not shareable".
  maxSharedUsers    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
}

/// A scheduled class — one instructor, a starts-at, a duration, a capacity.
/// All of the unit's active bikes are bookable for this slot unless we add
/// per-slot exclusions later.
model ClassSlot {
  id              String     @id @default(cuid())
  unitId          String
  unit            Unit       @relation(fields: [unitId], references: [id])
  instructorId    String
  instructor      User       @relation("InstructedSlots", fields: [instructorId], references: [id])
  /// Optional preset kind (sunrise/sunset/etc). When set, frontend uses its
  /// name + tone + intensity for display. When null, falls back to `title`.
  classKindId     String?
  classKind       ClassKind? @relation(fields: [classKindId], references: [id])
  title           String?
  startsAt        DateTime
  durationMinutes Int
  /// Maximum number of concurrent reservations. Typically equal to or less than
  /// the unit's active-bike count. Set by admin/instructor on creation.
  capacity        Int

  status                     ClassSlotStatus             @default(SCHEDULED)
  /// Discriminator for which reason column applies. Service enforces that
  /// exactly one of personal/studio reason is non-null when this is set.
  cancellationKind           CancellationKind?
  personalCancellationReason PersonalCancellationReason?
  studioCancellationReason   StudioCancellationReason?
  cancellationDescription    String?
  cancelledByUserId          String?
  cancelledBy                User?                       @relation("CancelledByUserSlots", fields: [cancelledByUserId], references: [id])
  cancelledAt                DateTime?

  /// Wall-clock instant the instructor confirmed the class started. While
  /// null and `now > startsAt`, the cron's auto-confirm job is allowed to
  /// flip this on its own (with `autoStartConfirmed = true`).
  confirmedStartedAt         DateTime?
  /// True when the cron promoted the slot without an instructor tap. Used
  /// in audit views so admins can spot instructors who routinely miss the
  /// confirm window.
  autoStartConfirmed         Boolean                     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations    Reservation[]
  waitlistEntries WaitlistEntry[]

  @@index([unitId, startsAt])
  @@index([instructorId, startsAt])
  @@index([status, startsAt])
}

/// A single (user, classSlot, bike) booking. Always sourced from a CreditPack.
///
/// Concurrency note — the `activeKey` column enforces "one ACTIVE/CHECKED_IN
/// reservation per (slot, bike)" via Postgres' "NULL is distinct in UNIQUE"
/// behaviour:
///   - On create:   `activeKey = "${classSlotId}:${bikeId}"`
///   - On cancel/no-show/complete: set to NULL (multiple NULLs allowed)
/// This avoids needing a partial-index migration while still preventing
/// double-booking of a bike for the same slot. The status enum remains the
/// source of truth for state; activeKey is a derived constraint helper.
model Reservation {
  id           String     @id @default(cuid())
  classSlotId  String
  classSlot    ClassSlot  @relation(fields: [classSlotId], references: [id])
  bikeId       String
  bike         Bike       @relation(fields: [bikeId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  creditPackId String
  creditPack   CreditPack @relation(fields: [creditPackId], references: [id])

  promotedFromWaitlist Boolean @default(false)

  status            ReservationStatus @default(ACTIVE)
  /// See model-level note. Set by service layer.
  activeKey         String?           @unique
  checkedInAt       DateTime?
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledBy       User?             @relation("ReservationCancelledBy", fields: [cancelledByUserId], references: [id])
  /// Free-text reason supplied when the user marks themselves NO_SHOW
  /// (E4) or when an admin/instructor cancels for an explicit reason
  /// outside the structured ClassSlot.cancellationReason enum.
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classSlotId])
  @@index([userId])
  @@index([bikeId])
  @@index([creditPackId])
}

/// FIFO queue per ClassSlot. When a reservation is cancelled, the next entry
/// is auto-promoted (a new Reservation is created and a credit is consumed).
model WaitlistEntry {
  id          String    @id @default(cuid())
  classSlotId String
  classSlot   ClassSlot @relation(fields: [classSlotId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  joinedAt    DateTime  @default(now())
  promotedAt  DateTime?
  removedAt   DateTime?

  /// 2026-05 — joining the waitlist consumes 1 credit upfront. We track
  /// which pack the credit came from so we can refund the exact bucket
  /// when the user leaves the queue, when the studio cancels the slot,
  /// or when the slot starts without promoting this entry. `null` for
  /// legacy rows created before this rule (pre-migration data).
  creditPackId String?
  creditPack   CreditPack? @relation(fields: [creditPackId], references: [id])
  /// When `joinedAt`'s credit decrement was refunded — i.e., the entry
  /// terminated without a promotion. Mutually exclusive with `promotedAt`
  /// in practice (a promoted entry inherits the credit consumption).
  refundedAt   DateTime?

  /// One waitlist entry per user per slot. Cancelling a queued entry deletes
  /// the row (or sets removedAt — TBD when we wire 5b).
  @@unique([classSlotId, userId])
  @@index([classSlotId, joinedAt])
  @@index([creditPackId])
}

// =============================================================================
// Credits, plans, subscriptions, payments
// =============================================================================

/// A bucket of class credits. Sources: bought as a one-off pack, granted by a
/// subscription cycle, granted by admin, or refunded from a cancelled reservation.
/// Reservation always consumes 1 credit from one CreditPack.
model CreditPack {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  source           CreditSource
  totalCredits     Int
  remainingCredits Int
  /// NULL means never expires (rare — admin grants only, typically).
  expiresAt        DateTime?

  /// If sourced from a Subscription cycle, link back for traceability.
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  /// If sourced from a one-off Payment, link back. Subscription cycles also
  /// have an associated Payment; that link is reflected on Payment.creditPackId.
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  /// 2026-05 — snapshot of the PackOffer's transfer/share flags at the
  /// time this pack was created. Snapshotted (not joined) so an admin
  /// editing the offer later doesn't retroactively change what an
  /// already-bought pack is allowed to do.
  isTransferable Boolean @default(false)
  /// Max friends that can co-own this pack (already includes the buyer
  /// implicitly). 0 = sharing disabled. Counted against the live
  /// `coOwners` set.
  maxSharedUsers Int     @default(0)

  reservations Reservation[]
  /// 2026-05 — waitlist entries that consumed a credit from this pack
  /// upfront. We need the inverse relation so cascade behaviour stays
  /// explicit, and so a service-level audit could surface "X pending
  /// waitlists are holding Y credits".
  waitlistEntries WaitlistEntry[]
  /// 2026-05 — friends that co-own this pack and can also consume from
  /// the same `remainingCredits` pool. Empty for solo packs. The pack's
  /// `userId` (the buyer) is NOT mirrored here — they're the implicit
  /// owner. The atomic `updateMany {remainingCredits: gt 0}` decrement
  /// trivially handles the concurrency case (last-writer-wins-but-positive).
  coOwners CreditPackCoOwner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// "Pack with credits left, not expired" lookup is the hot path during reservation.
  @@index([userId, expiresAt])
  @@index([userId, remainingCredits])
}

/// 2026-05 — Junction for friends that co-own a CreditPack alongside the
/// buyer. Concurrency: every consumer (buyer or co-owner) hits the same
/// `CreditPack.remainingCredits` row through the atomic conditional
/// decrement, so no two reservations can both win the last credit.
model CreditPackCoOwner {
  creditPackId String
  creditPack   CreditPack @relation(fields: [creditPackId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@id([creditPackId, userId])
  @@index([userId])
}

/// A purchasable monthly plan (e.g. "Plano 8 aulas — R$ 199/mês").
model Plan {
  id             String   @id @default(cuid())
  name           String
  monthlyCredits Int
  priceCents     Int
  isActive       Boolean  @default(true)
  /// Optional time-windowed discount — same shape as PackOffer (see C3).
  discountPercent   Int?
  discountStartsAt  DateTime?
  discountEndsAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions Subscription[]
}

/// One subscription per user-cycle. Cancelled subs stay for history.
model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  /// Asaas subscription id. Optional during creation, set after Asaas confirms.
  asaasSubscriptionId String?            @unique
  status              SubscriptionStatus @default(PENDING_PAYMENT)
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  cancelledAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditPacks CreditPack[]
  payments    Payment[]

  @@index([userId, status])
}

/// A monetary transaction — either a one-off pack purchase or a subscription
/// cycle charge. Asaas is the source of truth; this row mirrors it for our use.
model Payment {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  asaasChargeId String        @unique
  amountCents   Int
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  kind          PaymentKind
  paidAt        DateTime?

  /// Set when kind = SUBSCRIPTION_CYCLE.
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  /// Set when kind = ONE_OFF_PACK. Snapshots the pack at purchase time so the
  /// webhook can mint the correct CreditPack regardless of the admin later
  /// editing or removing the offer.
  packCredits        Int?
  packExpirationDays Int?

  /// 2026-05 — card-payment metadata. NULL for PIX. `installments` is the
  /// number of parcelas (1 = à vista); the interest, when parcelado, is
  /// applied by Asaas (dashboard config) and folded into `amountCents`.
  /// `cardBrand` / `cardLast4` come from the Asaas response — used in the
  /// receipt and payment history ("crédito •••• 1234"). `failureReason`
  /// holds the decline reason for FAILED card charges.
  installments  Int?
  cardBrand     String?
  cardLast4     String?
  failureReason String?

  /// The CreditPack created from this Payment (when applicable). Backref of
  /// CreditPack.payment.
  creditPacks CreditPack[]

  /// 2026-05 — debts whose origin is this (refunded / charged-back) Payment.
  debtsOriginated CreditDebt[] @relation("DebtOrigin")
  /// 2026-05 — debts that this Payment's CreditPack settled on purchase.
  debtsSettled    CreditDebt[] @relation("DebtSettlement")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/// 2026-05 — a credit debt owed by a user. Created when a card Payment is
/// refunded or charged back AFTER some of its CreditPack credits were already
/// consumed: the unused credits are zeroed on the pack, the already-consumed
/// ones become this debt. The debt never expires. It is settled by the next
/// pack purchase — `applyPaymentConfirmation` deducts `remainingCredits` here
/// from the freshly-minted pack before crediting the user. While any debt has
/// `remainingCredits > 0` the user is blocked from new reservations (structured
/// 403, same pattern as the health gate).
model CreditDebt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  reason CreditDebtReason

  /// Credits originally owed vs still outstanding. `remainingCredits` hits 0
  /// when fully settled; `settledAt` is stamped at that moment.
  amountCredits    Int
  remainingCredits Int

  /// The refunded / charged-back Payment that produced this debt.
  originPaymentId String
  originPayment   Payment @relation("DebtOrigin", fields: [originPaymentId], references: [id])

  /// The Payment whose pack purchase settled this debt (set once, when the
  /// debt first reaches remainingCredits = 0).
  settledByPaymentId String?
  settledByPayment   Payment? @relation("DebtSettlement", fields: [settledByPaymentId], references: [id])
  settledAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Hot path: "does this user have an open debt?" gate on reservation.
  @@index([userId, remainingCredits])
}

// =============================================================================
// G1 — Friends
// =============================================================================

/// Friend invitation flow. A row is created in PENDING by `from`, then
/// transitions to ACCEPTED / DECLINED / CANCELLED. ACCEPTED rows trigger
/// a `Friendship` record creation in the same transaction. Past terminal
/// rows remain so re-sending the same code (after a decline) is one extra
/// row instead of mutating history.
///
/// Concurrency note: only ONE PENDING row per ordered (from, to) pair is
/// allowed at a time, enforced by a partial unique index in raw SQL —
/// Prisma can't express partial uniques natively, so we use a regular
/// unique on `(fromUserId, toUserId, status)` plus service-level check
/// to keep the model expressive without raw migrations.
model FriendRequest {
  id           String              @id @default(cuid())
  fromUserId   String
  fromUser     User                @relation("FriendRequestFrom", fields: [fromUserId], references: [id])
  toUserId     String
  toUser       User                @relation("FriendRequestTo", fields: [toUserId], references: [id])
  status       FriendRequestStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  respondedAt  DateTime?

  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
}

/// Bidirectional friendship. The pair is stored with deterministic ordering
/// (`userAId < userBId`) so each friendship has exactly one row regardless
/// of who initiated. Lookups go via OR on either side. Removing a friend
/// deletes the row — Prisma's `delete` is idempotent enough that re-tries
/// don't break the UI.
model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userA     User     @relation("FriendshipA", fields: [userAId], references: [id])
  userBId   String
  userB     User     @relation("FriendshipB", fields: [userBId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}
