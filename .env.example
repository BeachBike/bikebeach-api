# Database — must match the credentials in the root docker-compose.yml / root .env
DATABASE_URL="postgresql://app:app@localhost:5432/beachbike?schema=public"

# App
PORT=3000

# CORS allowlist for the browser-facing /web app. Comma-separated; each entry
# can be a literal origin or a glob (`*` becomes regex). Leave unset or set to
# "*" in dev to allow any origin.
# Example for prod + Vercel previews:
#   CORS_ORIGINS=https://bikebeach.com.br,https://bikebeach-web.vercel.app,https://bikebeach-web-*.vercel.app
CORS_ORIGINS=*

# Auth — JWT_SECRET must be at least 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial admin — consumed by `npx prisma db seed` (idempotent).
# If both vars are set, seed creates an ADMIN with that email or promotes the
# existing user to ADMIN. Leave blank in prod after the admin exists.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Admin

# Asaas — sandbox or production. Sandbox keys start with `$aact_hmlg_`.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Match this value in Asaas dashboard → Integrações → Webhooks → "Token de Autenticação"
ASAAS_WEBHOOK_TOKEN=

# Resend (transactional e-mail). Leave blank in dev — the mailer logs to
# console and marks the send as SKIPPED. Set in prod to actually deliver.
RESEND_API_KEY=
# Verified sender in Resend. Format: `name <local@domain>`.
EMAIL_FROM=bikebeach <ola@bikebeach.com.br>
# Public base URL of the /web app — used in template CTA links.
APP_URL=http://localhost:5173

# CPF encryption at rest (LGPD). 32 bytes base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If you LOSE this key every stored CPF is unrecoverable — back it up
# offline AND in the Railway environment.
CPF_ENCRYPTION_KEY=

# Cloudflare R2 — object storage for instructor portraits. Leave blank in
# dev (falls back to local /uploads/instructors). In prod, fill ALL FIVE.
#
# Setup (5 minutes):
#   1. Create a Cloudflare account (free) and enable R2 in the dashboard.
#   2. Create a bucket (e.g. "bikebeach-media").
#   3. Bucket settings → "Public Access" → enable r2.dev subdomain OR
#      attach a custom domain (e.g. media.bikebeach.com.br).
#   4. R2 → "Manage R2 API Tokens" → create token with Object Read+Write
#      permission scoped to this one bucket.
#   5. Copy the four credentials below.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
