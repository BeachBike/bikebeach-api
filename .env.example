# Database — must match the credentials in the root docker-compose.yml / root .env
DATABASE_URL="postgresql://app:app@localhost:5432/beachbike?schema=public"

# App
PORT=3000

# Auth — JWT_SECRET must be at least 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial admin — consumed by `npx prisma db seed` (idempotent).
# If both vars are set, seed creates an ADMIN with that email or promotes the
# existing user to ADMIN. Leave blank in prod after the admin exists.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Admin

# Asaas — sandbox or production. Sandbox keys start with `$aact_hmlg_`.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Match this value in Asaas dashboard → Integrações → Webhooks → "Token de Autenticação"
ASAAS_WEBHOOK_TOKEN=
